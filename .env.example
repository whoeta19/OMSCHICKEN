# ===== OMSFIN — переменные окружения =====
# Это ШАБЛОН. Реальные значения НЕ хранятся в git.
# Все ключи задаются в Vercel: Project → Settings → Environment Variables.
# Скопируй файл в .env для локального запуска (.env уже в .gitignore).

# --- Supabase ---
SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
# anon-ключ — публичный, тоже прописан в HTML на клиенте
SUPABASE_ANON_KEY=
# service_role-ключ — СЕКРЕТНЫЙ, обходит RLS, только на сервере. Никогда не в HTML/git!
SUPABASE_SERVICE_KEY=

# --- Telegram-бот @omsfin_bot ---
TELEGRAM_BOT_TOKEN=

# --- Внешние сервисы ---
GEMINI_API_KEY=
RESEND_API_KEY=
DADATA_TOKEN_FINDBYID=
DADATA_TOKEN_SUGGEST=
DADATA_TOKEN=

# --- Секрет для cron-уведомлений (api/notify.js) ---
CRON_SECRET=
